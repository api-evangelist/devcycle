              }
            ]
          },
          "docs": "DEPRECATED - Not recommended to be used. Use /integrations/jira/organization/:token or /integrations/jira/project/:token instead."
        },
        {
          "info": {
            "name": "Remove Jira Organization Integration Configuration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://bucketing-api.devcycle.com/v1/integrations/jira/organization/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove the Jira integration configuration for an organization. This will remove the integration for an organization wide connection, but not project connections."
        },
        {
          "info": {
            "name": "Remove Jira Project Integration Configuration",
            "type": "http"
