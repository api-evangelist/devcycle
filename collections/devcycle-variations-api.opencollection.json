{
  "opencollection": "1.0.0",
  "info": {
    "name": "DevCycle Bucketing Audiences Variations API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Variations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Feature Variations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:project/features/:feature/variations",
            "params": [
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "Get a list of variations for a feature"
        },
        {
          "info": {
            "name": "Create a Feature Variation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:project/features/:feature/variations",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new variation within a Feature"
        },
        {
          "info": {
            "name": "Get a Feature Variation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:project/features/:feature/variations/:key",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "A Variation key or ID"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "Get a variation by ID or key"
        },
        {
          "info": {
            "name": "Update a Feature Variation",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:project/features/:feature/variations/:key",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a variation by ID or key"
        }
      ]
    }
  ],
  "bundled": true
}