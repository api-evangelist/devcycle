            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:project/features/:feature/configurations",
            "params": [
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "A Environment key or ID"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "List Feature configurations for all environments or by environment key or ID"
        },
        {
          "info": {
            "name": "Update a Feature configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:project/features/:feature/configurations",
            "params": [
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "A Environment key or ID"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Feature configuration by environment key or ID"
        }
      ]
    }
  ],
  "bundled": true
