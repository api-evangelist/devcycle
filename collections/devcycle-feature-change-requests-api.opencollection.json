{
  "opencollection": "1.0.0",
  "info": {
    "name": "DevCycle Bucketing Audiences Feature Change Requests API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Feature Change Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of Pending Feature Change Requests for a Feature",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests",
            "params": [
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "Get all pending Feature Change Requests for a Feature"
        },
        {
          "info": {
            "name": "Create Feature Change Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests",
            "params": [
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Feature Change Request"
        },
        {
          "info": {
            "name": "Get the latest non-draft Feature Change Request for a Feature",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests/latest",
            "params": [
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "Get the latest Feature Change Request for a Feature that is NOT in the 'draft' state"
        },
        {
          "info": {
            "name": "Get a Feature Change Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "Get a Feature Change Request by ID"
        },
        {
          "info": {
            "name": "Submit Feature Change Request for Review",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests/:id/submit",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a Feature Change Request for Review"
        },
        {
          "info": {
            "name": "Review a Pending Feature Change Request",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests/:id/review",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "apply",
                "value": "",
                "type": "query",
                "description": "Controls whether the review should also apply the change request to the feature"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Feature Change Request by ID"
        },
        {
          "info": {
            "name": "Review a Pending Feature Change Request",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests/:id/apply",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Feature Change Request by ID"
        },
        {
          "info": {
            "name": "Cancel a Pending Feature Change Request",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://bucketing-api.devcycle.com/v2/projects/:project/features/:feature/change-requests/:id/cancel",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "A Feature key or ID"
              },
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "Cancel a Feature Change Request by ID"
        }
      ]
    }
  ],
  "bundled": true
}