              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "createdBy",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists all projects that the current API Token has permission to view."
        },
        {
          "info": {
            "name": "Create project in the current organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://bucketing-api.devcycle.com/v1/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new project within the authed organization.\nThe project key must be unique within the organization.\nIf this is called in an Organization that has permissions controlled via an external IdP (https://docs.devcycle.com/platform/security-and-guardrails/permissions#full-role-based-access-control-project-level-roles--enterprise-only) - then no users will have permission to access this project."
        },
        {
          "info": {
            "name": "Get a Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:key",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "A Project key or ID"
              }
            ]
          },
          "docs": "Get a Project by ID or key."
        },
        {
          "info": {
            "name": "Update a Project",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://bucketing-api.devcycle.com/v1/projects/:key",
